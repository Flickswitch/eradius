%% vim: ft=erlang
%% Modern sample config for eradius_server_sample + OTP logger.
[
 {kernel, [
    {logger, [
        {handler, default, logger_std_h,
         #{level => info,
           formatter => {logger_formatter,
                         #{template => [time, " ", level, " ",
                                        {domain, ["[", domain, "] "], []},
                                        pid, " ", msg, "\n"],
                           single_line => true}}
          }}
    ]},
    {logger_level, info}
 ]},
 {eradius, [
    {client_ip, {127, 0, 0, 1}},
    {client_ports, 256},
    {resend_timeout, 500},
    {unreachable_timeout, 60},
    {recbuf, 4000000},
    {tables, [dictionary]},
    {session_nodes, local},
    {logging, false},
    {logfile, "./radius.log"},
    {radius_callback, eradius_server_sample},
    {servers_pool, []},
    {counter_aggregator, false},
    {server_status_metrics_enabled, false},
    {histogram_buckets, [10, 30, 50, 75, 100, 1000, 2000]},
    {root, [
        {{"root", []}, [{"127.0.0.1", "secret"}]}
    ]},
    {servers, [
        {root, {"127.0.0.1", [1812, 1813]}}
    ]}
 ]}
].
