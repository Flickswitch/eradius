%-*-Erlang-*-
{kernel,
 [{logger,
   [{handler, default, logger_std_h,
     #{level => info,
       formatter => {logger_formatter,
                     #{template => [time, " ", level, " ",
                                    {domain, ["[", domain, "] "], []},
                                    pid, " ", msg, "\n"],
                       single_line => true}},
       config =>
           #{sync_mode_qlen => 10000,
             drop_mode_qlen => 10000,
             flush_qlen     => 10000}
      }
    }
   ]},
  {logger_level, info}
 ]}.

{eradius, [
   {servers, []},
   {session_nodes, local},
   {logging, true},
   {logfile, "./radius.log"},
   {tables, [dictionary]},
   {client_ip, undefined},
   {client_ports, 20},
   {resend_timeout, 30000},
   {unreachable_timeout, 60},
   {recbuf, 8192},
   {counter_aggregator, false},
   {server_status_metrics_enabled, false},
   {servers_pool, []},
   {histogram_buckets, [10, 30, 50, 75, 100, 1000, 2000]}
]}.
